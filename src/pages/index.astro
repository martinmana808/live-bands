---
import '../styles/global.css';
import MonthHeading from '../components/MonthHeading.astro';
import EventRow from '../components/EventRow.astro';
import Soundwave from '../components/Soundwave.astro';
import events from '../../data/events.json';
import { todayInBuenosAires } from '../../fetcher/today.js';
import { isWithinDays, isRecentlyAdded } from '../../fetcher/display.js';

const today = todayInBuenosAires();

function monthLabel(yyyymm) {
  const [y, m] = yyyymm.split('-').map(Number);
  const months = ['JANUARY','FEBRUARY','MARCH','APRIL','MAY','JUNE','JULY','AUGUST','SEPTEMBER','OCTOBER','NOVEMBER','DECEMBER'];
  return `${months[m-1]} ${y}`;
}

const FORTNIGHT_DAYS = 14;
const fortnightCount = events.filter(e => isWithinDays(e.date, today, FORTNIGHT_DAYS)).length;
const recentCount = events.filter(e => isRecentlyAdded(e, today)).length;

const groups = [];
let currentKey = null;
for (const e of events) {
  const key = e.date.slice(0, 7);
  if (key !== currentKey) {
    groups.push({ key, label: monthLabel(key), events: [] });
    currentKey = key;
  }
  groups[groups.length - 1].events.push(e);
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>International bands in Buenos Aires</title>
  </head>
  <body>
    <Soundwave events={events} today={today} />
    <main>
      <h1>International bands in Buenos Aires</h1>
      <nav class="filters" aria-label="Filter shows">
        <button type="button" class="filter on" data-filter="all" aria-pressed="true">
          All <span class="count">{events.length}</span>
        </button>
        <button type="button" class="filter" data-filter="fortnight" aria-pressed="false">
          Next 14 days <span class="count">{fortnightCount}</span>
        </button>
        <button type="button" class="filter" data-filter="new" aria-pressed="false">
          New this week <span class="count">{recentCount}</span>
        </button>
      </nav>
      <p class="empty" hidden>Nothing matches that filter.</p>
      {groups.map(g => (
        <section>
          <MonthHeading label={g.label} />
          {g.events.map(e => (
            <EventRow
              event={e}
              today={today}
              fortnight={isWithinDays(e.date, today, FORTNIGHT_DAYS)}
              recent={isRecentlyAdded(e, today)}
            />
          ))}
        </section>
      ))}
      <footer>
        Updated daily. Sources: Songkick, Vorterix, Niceto.
      </footer>
    </main>

    <script>
      const FILTER_KEY = 'bit:filter';

      function applyFilter(name) {
        document.querySelectorAll('button.filter').forEach(b => {
          const on = b.getAttribute('data-filter') === name;
          b.classList.toggle('on', on);
          b.setAttribute('aria-pressed', String(on));
        });
        let shown = 0;
        document.querySelectorAll('.event').forEach(row => {
          const ok = name === 'all'
            || (name === 'fortnight' && row.hasAttribute('data-fortnight'))
            || (name === 'new' && row.hasAttribute('data-recent'));
          row.hidden = !ok;
          if (ok) shown++;
        });
        // A month heading with nothing under it reads as a bug.
        document.querySelectorAll('main section').forEach(sec => {
          sec.hidden = ![...sec.querySelectorAll('.event')].some(r => !r.hidden);
        });
        const empty = document.querySelector('p.empty');
        if (empty) empty.hidden = shown > 0;
        try { localStorage.setItem(FILTER_KEY, name); } catch {}
      }

      document.querySelectorAll('button.filter').forEach(btn => {
        btn.addEventListener('click', () => applyFilter(btn.getAttribute('data-filter')));
      });

      try {
        const saved = localStorage.getItem(FILTER_KEY);
        if (saved && saved !== 'all') applyFilter(saved);
      } catch {}

      const FAV_KEY = 'bit:favs';
      const loadFavs = () => { try { return new Set(JSON.parse(localStorage.getItem(FAV_KEY) || '[]')); } catch { return new Set(); } };
      const saveFavs = (s) => localStorage.setItem(FAV_KEY, JSON.stringify([...s]));

      const favs = loadFavs();
      document.querySelectorAll('button.fav[data-fav-id]').forEach(btn => {
        if (favs.has(btn.getAttribute('data-fav-id'))) btn.classList.add('on');
      });

      document.addEventListener('click', async (e) => {
        const play = e.target.closest('button.play[data-spotify-id]');
        if (play) {
          const row = play.closest('.event');
          const existing = row.querySelector('.embed');
          if (existing) { existing.remove(); return; }
          const id = play.getAttribute('data-spotify-id');
          const div = document.createElement('div');
          div.className = 'embed';
          div.innerHTML = `<iframe src="https://open.spotify.com/embed/artist/${id}" allow="encrypted-media"></iframe>`;
          row.appendChild(div);
          return;
        }
        const fav = e.target.closest('button.fav[data-fav-id]');
        if (fav) {
          const id = fav.getAttribute('data-fav-id');
          const set = loadFavs();
          if (set.has(id)) { set.delete(id); fav.classList.remove('on'); }
          else { set.add(id); fav.classList.add('on'); }
          saveFavs(set);
          return;
        }
        const share = e.target.closest('button.share[data-share-text]');
        if (share) {
          const text = share.getAttribute('data-share-text');
          const row = share.closest('.event');
          const url = location.origin + location.pathname + '#event-' + row.getAttribute('data-event-id');
          const payload = { title: 'Bands in Town', text, url };
          try {
            if (navigator.share) await navigator.share(payload);
            else { await navigator.clipboard.writeText(`${text}\n${url}`); share.classList.add('on'); setTimeout(() => share.classList.remove('on'), 1000); }
          } catch {}
        }
      });
    </script>
  </body>
</html>
