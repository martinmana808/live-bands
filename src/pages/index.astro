---
import '../styles/global.css';
import MonthHeading from '../components/MonthHeading.astro';
import EventRow from '../components/EventRow.astro';
import Soundwave from '../components/Soundwave.astro';
import events from '../../data/events.json';
import { todayInBuenosAires } from '../../fetcher/today.js';
import { isWithinDays, isRecentlyAdded } from '../../fetcher/display.js';
import committedMuted from '../../data/muted.json';
import { familyCounts } from '../../fetcher/genres.js';

const today = todayInBuenosAires();

function monthLabel(yyyymm) {
  const [y, m] = yyyymm.split('-').map(Number);
  const months = ['JANUARY','FEBRUARY','MARCH','APRIL','MAY','JUNE','JULY','AUGUST','SEPTEMBER','OCTOBER','NOVEMBER','DECEMBER'];
  return `${months[m-1]} ${y}`;
}

const FORTNIGHT_DAYS = 14;
const fortnightCount = events.filter(e => isWithinDays(e.date, today, FORTNIGHT_DAYS)).length;
const recentCount = events.filter(e => isRecentlyAdded(e, today)).length;

const families = familyCounts(events);

const groups = [];
let currentKey = null;
for (const e of events) {
  const key = e.date.slice(0, 7);
  if (key !== currentKey) {
    groups.push({ key, label: monthLabel(key), events: [] });
    currentKey = key;
  }
  groups[groups.length - 1].events.push(e);
}
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>International bands in Buenos Aires</title>
  </head>
  <body>
    <div class="backdrop" aria-hidden="true">
      <div class="backdrop-layer" data-layer="a"></div>
      <div class="backdrop-layer" data-layer="b"></div>
    </div>
    <Soundwave events={events} today={today} />
    <main>
      <h1>International bands in Buenos Aires</h1>
      <div class="searchbar">
        <input type="search" id="q" placeholder="Search artist, venue or country…" autocomplete="off" spellcheck="false" aria-label="Search shows" />
        <button type="button" id="q-clear" aria-label="Clear search" hidden>&times;</button>
      </div>
      <nav class="filters" aria-label="Filter shows">
        <button type="button" class="filter on" data-filter="all" aria-pressed="true">
          All <span class="count">{events.length}</span>
        </button>
        <button type="button" class="filter" data-filter="fortnight" aria-pressed="false">
          Next 14 days <span class="count">{fortnightCount}</span>
        </button>
        <button type="button" class="filter" data-filter="new" aria-pressed="false">
          New this week <span class="count">{recentCount}</span>
        </button>
        <button type="button" class="filter muted-filter" data-filter="muted" aria-pressed="false" hidden>
          Hidden <span class="count">0</span>
        </button>
      </nav>
      {families.length > 0 && (
        <nav class="genres-nav" aria-label="Filter by genre">
          {families.map(([name, count]) => (
            <button type="button" class="genre" data-genre={name} aria-pressed="false">
              {name} <span class="count">{count}</span>
            </button>
          ))}
        </nav>
      )}
      <p class="result-count" aria-live="polite" hidden></p>
      <section id="muted-panel" hidden>
        <h2>Hidden artists</h2>
        <p class="muted-help">These never show up in the list or the Telegram digest. Click to bring one back.</p>
        <ul id="muted-list"></ul>
        <p class="muted-sync">
          To hide these in the digest too, commit them to <code>data/muted.json</code>:
          <button type="button" id="muted-copy">Copy list</button>
        </p>
      </section>
      <p class="empty" hidden>Nothing matches.</p>
      {groups.map(g => (
        <section>
          <MonthHeading label={g.label} />
          {g.events.map(e => (
            <EventRow
              event={e}
              today={today}
              fortnight={isWithinDays(e.date, today, FORTNIGHT_DAYS)}
              recent={isRecentlyAdded(e, today)}
            />
          ))}
        </section>
      ))}
      <footer>
        Updated daily. Sources: Songkick, Livepass, Vorterix, Niceto.
      </footer>
    </main>

    <div id="player" hidden aria-label="Now playing">
      <div class="player-inner">
        <img id="player-art" alt="" width="44" height="44" />
        <div class="player-meta">
          <span id="player-name"></span>
          <span class="player-hint">Top tracks</span>
        </div>
        <div class="player-controls">
          <button type="button" id="player-prev" aria-label="Previous artist" title="Previous artist">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M6 6h2v12H6zM18 6v12L9 12z"/></svg>
          </button>
          <button type="button" id="player-toggle" aria-label="Pause" title="Play / pause">
            <svg class="ico-pause" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
            <svg class="ico-play" viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </button>
          <button type="button" id="player-next" aria-label="Next artist" title="Next artist">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M16 6h2v12h-2zM6 6v12l9-6z"/></svg>
          </button>
        </div>
        <div id="player-embed"><div id="player-embed-host"></div></div>
      </div>
    </div>

    <script type="application/json" id="committed-muted" set:html={JSON.stringify(committedMuted)}></script>
    <script>
      import { createApp } from '../scripts/filters.js';
      import { createPlayer } from '../scripts/player.js';
      createApp({ doc: document, storage: localStorage }).attach().render();
      createPlayer({ doc: document }).attach();

      const FAV_KEY = 'bit:favs';
      const loadFavs = () => { try { return new Set(JSON.parse(localStorage.getItem(FAV_KEY) || '[]')); } catch { return new Set(); } };
      const saveFavs = (s) => localStorage.setItem(FAV_KEY, JSON.stringify([...s]));

      const favs = loadFavs();
      document.querySelectorAll('button.fav[data-fav-id]').forEach(btn => {
        if (favs.has(btn.getAttribute('data-fav-id'))) btn.classList.add('on');
      });

      document.addEventListener('click', async (e) => {
        const fav = e.target.closest('button.fav[data-fav-id]');
        if (fav) {
          const id = fav.getAttribute('data-fav-id');
          const set = loadFavs();
          if (set.has(id)) { set.delete(id); fav.classList.remove('on'); }
          else { set.add(id); fav.classList.add('on'); }
          saveFavs(set);
          return;
        }
        const share = e.target.closest('button.share[data-share-text]');
        if (share) {
          const text = share.getAttribute('data-share-text');
          const row = share.closest('.event');
          const url = location.origin + location.pathname + '#e-' + row.getAttribute('data-short-id');
          const payload = { title: 'Bands in Town', text, url };
          try {
            if (navigator.share) await navigator.share(payload);
            else { await navigator.clipboard.writeText(`${text}\n${url}`); share.classList.add('on'); setTimeout(() => share.classList.remove('on'), 1000); }
          } catch {}
        }
      });
    </script>
  </body>
</html>
