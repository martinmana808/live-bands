---
const { events, today } = Astro.props;

function addDays(iso, n) {
  const d = new Date(iso + 'T00:00:00Z');
  d.setUTCDate(d.getUTCDate() + n);
  return d.toISOString().slice(0, 10);
}
function diffDays(a, b) {
  const da = new Date(a + 'T00:00:00Z');
  const db = new Date(b + 'T00:00:00Z');
  return Math.round((db - da) / 86400000);
}
function monthAbbr(iso) {
  const months = ['JAN','FEB','MAR','APR','MAY','JUN','JUL','AUG','SEP','OCT','NOV','DEC'];
  return months[Number(iso.slice(5, 7)) - 1];
}

const start = today;
const lastEvent = events.length > 0 ? events[events.length - 1].date : today;
const yearEnd = `${start.slice(0, 4)}-12-31`;
const end = lastEvent > yearEnd ? lastEvent : yearEnd;
const totalDays = Math.max(1, diffDays(start, end) + 1);

const counts = new Array(totalDays).fill(0);
for (const e of events) {
  const idx = diffDays(start, e.date);
  if (idx >= 0 && idx < totalDays) counts[idx]++;
}

const rows = counts.map((count, i) => {
  const date = addDays(start, i);
  const day = Number(date.slice(8, 10));
  return { date, count, label: day === 1 ? monthAbbr(date) : null };
});
---
<aside class="soundwave" aria-hidden="true">
  <div class="rail">
    {rows.map(r => (
      <button
        class={`bar${r.count > 0 ? ' active' : ''}`}
        style={r.count > 0 ? `--w: ${Math.min(100, 30 + r.count * 25)}%` : ''}
        data-bucket-start={r.date}
        data-count={r.count}
        aria-label={`${r.count} events on ${r.date}`}
        disabled={r.count === 0}
      >
        {r.label && <span class="label">{r.label}</span>}
      </button>
    ))}
  </div>
</aside>

<script>
  document.addEventListener('click', (e) => {
    const bar = e.target.closest('button.bar.active[data-bucket-start]');
    if (!bar) return;
    const start = bar.getAttribute('data-bucket-start');
    const rows = document.querySelectorAll('[data-event-date]');
    for (const row of rows) {
      if (row.getAttribute('data-event-date') >= start) {
        row.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
    }
  });
</script>
