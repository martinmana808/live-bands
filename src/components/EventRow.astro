---
import { genreFamilies } from '../../fetcher/genres.js';

const { event, today, fortnight = false, recent = false } = Astro.props;
const families = genreFamilies(event.genres);
const past = event.date < today;

function countryFlag(code) {
  if (!code || code.length !== 2) return '';
  return String.fromCodePoint(...[...code.toUpperCase()].map(c => 0x1F1E6 - 65 + c.charCodeAt(0)));
}

function formatDate(iso) {
  const d = new Date(iso + 'T00:00:00');
  const day = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][d.getUTCDay()];
  return `${day} ${String(d.getUTCDate()).padStart(2,'0')}`;
}

const flag = countryFlag(event.country);
const dateLabel = formatDate(event.date);
const ticket = event.ticketUrls?.[0];
const shareText = `${event.artist} @ ${event.venue} — ${event.date}`;
---
<div
  id={`e-${event.shortId}`}
  class={`event${past ? ' past' : ''}`}
  data-event-id={event.id}
  data-short-id={event.shortId}
  data-event-date={event.date}
  data-fortnight={fortnight ? '' : undefined}
  data-recent={recent ? '' : undefined}
  data-artist-key={event.artistKey}
  data-search={`${event.artist} ${event.venue} ${event.country ?? ''}`}
  data-genres={families.join(' ')}
>
  <div class="left-action">
    {ticket && !past ? (
      <a href={ticket} target="_blank" rel="noopener" aria-label="Buy ticket" title="Buy ticket">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 9a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v2a2 2 0 0 0 0 4v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-2a2 2 0 0 0 0-4z"/>
          <path d="M13 7v10" stroke-dasharray="2 2"/>
        </svg>
      </a>
    ) : <span class="ph" />}
  </div>
  <div class="thumb">
    {event.spotifyImage
      ? <img src={event.spotifyImage} alt="" loading="lazy" width="32" height="32" />
      : <span class="thumb-fallback" aria-hidden="true">♪</span>}
  </div>
  <div class="date">{dateLabel}</div>
  <div class="info">
    <div class="artist">{event.artist} {flag}{recent && <span class="badge-new">NEW</span>}</div>
    <div class="venue">
      {event.venue}{past ? ' (past)' : ''}
      {event.genres?.length > 0 && <span class="genres">{event.genres.slice(0, 3).join(' · ')}</span>}
    </div>
  </div>
  <div class="actions">
    {event.spotifyId ? (
      <button class="listen play" data-spotify-id={event.spotifyId} data-artist-name={event.artist} data-artist-image={event.spotifyImage ?? ''} aria-label={`Listen to ${event.artist}`} title={`Listen to ${event.artist}`}>
        <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
        Listen
      </button>
    ) : <span class="listen ph" aria-hidden="true"></span>}
    <button class="icon-btn fav" data-fav-id={event.id} aria-label="Save" title="Save">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>
      </svg>
    </button>
    <button class="icon-btn mute" data-mute-key={event.artistKey} data-mute-name={event.artist} aria-label={`Hide ${event.artist}`} title={`Hide ${event.artist}`}>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/>
        <circle cx="12" cy="12" r="3"/>
        <path d="M3 3l18 18"/>
      </svg>
    </button>
    <button class="icon-btn share" data-share-text={shareText} aria-label="Share" title="Share">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="6" cy="12" r="2.5"/>
        <circle cx="18" cy="6" r="2.5"/>
        <circle cx="18" cy="18" r="2.5"/>
        <path d="M8.2 10.8l7.6-3.6M8.2 13.2l7.6 3.6"/>
      </svg>
    </button>
  </div>
</div>
